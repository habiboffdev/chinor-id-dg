# Production Environment Variables for Opportuni MVP
# Copy this to .env on your production server

# Django Settings
SECRET_KEY=your-super-secret-key-generate-new-one
DEBUG=False
DJANGO_SETTINGS_MODULE=opportuni.settings.production

# Domain Configuration
DOMAIN_NAME=yourdomain.com
DROPLET_IP=your.droplet.ip.address

# Database Configuration (PostgreSQL)
DB_NAME=opportuni_db
DB_USER=opportuni_user
DB_PASSWORD=secure_database_password_here
DB_HOST=localhost
DB_PORT=5432

# SSL/HTTPS Configuration
USE_HTTPS=True

# Email Configuration (Optional - for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Optional: Redis for Caching (if you want to add Redis later)
REDIS_URL=redis://localhost:6379/1

# File Upload Limits
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880  # 5MB
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880  # 5MB
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# AWS S3 (for production file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=opportuni-files
AWS_S3_REGION_NAME=us-east-1

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key
