      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TelegramAuthResponse'
          description: ''
        '400':
          description: Invalid Telegram authentication data
        '500':
          description: Authentication failed
  /api/auth/telegram-config/:
    get:
      operationId: accounts_telegram_config
      description: Get Telegram bot configuration for frontend
      summary: Get Telegram Configuration
      tags:
      - accounts
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TelegramConfig'
          description: ''
  /api/communications/messages/:
    get:
      operationId: communications_messages_list
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
