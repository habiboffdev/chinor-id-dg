openapi: 3.0.3
info:
  title: Opportuni API
  version: 1.0.0
  description: Student Opportunity Management Platform API
paths:
  /api/applications/:
    get:
      operationId: applications_list
      parameters:
      - in: query
        name: applied_after
        schema:
          type: string
          format: date-time
      - in: query
        name: applied_before
        schema:
          type: string
          format: date-time
      - in: query
        name: opportunity_type
        schema:
          type: string
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: status
        schema:
          type: array
          items:
            type: string
            enum:
            - accepted
            - interview_scheduled
            - pending
            - rejected
            - under_review
            - withdrawn
        description: |-
          * `pending` - Pending
          * `under_review` - Under Review
          * `interview_scheduled` - Interview Scheduled
          * `accepted` - Accepted
          * `rejected` - Rejected
          * `withdrawn` - Withdrawn
        explode: true
        style: form
      - in: query
        name: student_university
        schema:
          type: string
      tags:
      - applications
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedApplicationListList'
          description: ''
    post:
      operationId: applications_create
      tags:
      - applications
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ApplicationCreate'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ApplicationCreate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ApplicationCreate'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApplicationCreate'
          description: ''
  /api/applications/{application_id}/documents/:
    get:
      operationId: applications_documents_list
      parameters:
      - in: path
        name: application_id
        schema:
          type: integer
        required: true
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - applications
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedApplicationDocumentList'
          description: ''
    post:
      operationId: applications_documents_create
      parameters:
      - in: path
        name: application_id
        schema:
          type: integer
        required: true
      tags:
      - applications
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ApplicationDocument'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ApplicationDocument'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ApplicationDocument'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApplicationDocument'
          description: ''
  /api/applications/{application_id}/notes/:
    get:
      operationId: applications_notes_list
      parameters:
      - in: path
        name: application_id
        schema:
          type: integer
        required: true
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - applications
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedApplicationNoteList'
          description: ''
    post:
      operationId: applications_notes_create
      parameters:
      - in: path
        name: application_id
        schema:
          type: integer
        required: true
      tags:
      - applications
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ApplicationNote'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ApplicationNote'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ApplicationNote'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApplicationNote'
          description: ''
  /api/applications/{id}/:
    get:
      operationId: applications_retrieve
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - applications
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Application'
          description: ''
    put:
      operationId: applications_update
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - applications
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
    patch:
      operationId: applications_partial_update
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - applications
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
    delete:
      operationId: applications_destroy
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - applications
      security:
      - jwtAuth: []
      responses:
        '204':
          description: No response body
  /api/applications/{id}/withdraw/:
    post:
      operationId: withdraw_application
      description: Withdraw a student application
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - applications
      security:
      - jwtAuth: []
      responses:
        '200':
          description: Application withdrawn successfully
        '400':
          description: Invalid operation
        '404':
          description: Application not found
  /api/applications/bulk-update/:
    post:
      operationId: bulk_update_application_status
      description: Bulk update application status for organization
      tags:
      - applications
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/BulkStatusUpdate'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/BulkStatusUpdate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/BulkStatusUpdate'
        required: true
      security:
      - jwtAuth: []
      responses:
        '200':
          description: Applications updated successfully
        '400':
          description: Invalid data
        '403':
          description: Only organizations allowed
  /api/applications/check-status/{opportunity_id}/:
    get:
      operationId: applications_check_status
      description: Check if the current student has already applied to a specific
        opportunity
      summary: Check Application Status
      parameters:
      - in: path
        name: opportunity_id
        schema:
          type: integer
        required: true
      tags:
      - applications
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApplicationList'
          description: ''
        '403':
          description: Only students allowed
        '404':
          description: Student profile not found
  /api/applications/org/:
    get:
      operationId: applications_org_list
      description: List applications scoped to the current organization with filters.
      parameters:
      - in: query
        name: applied_after
        schema:
          type: string
          format: date-time
      - in: query
        name: applied_before
        schema:
          type: string
          format: date-time
      - in: query
        name: opportunity_type
        schema:
          type: string
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: status
        schema:
          type: array
          items:
            type: string
            enum:
            - accepted
            - interview_scheduled
            - pending
            - rejected
            - under_review
            - withdrawn
        description: |-
          * `pending` - Pending
          * `under_review` - Under Review
          * `interview_scheduled` - Interview Scheduled
          * `accepted` - Accepted
          * `rejected` - Rejected
          * `withdrawn` - Withdrawn
        explode: true
        style: form
      - in: query
        name: student_university
        schema:
          type: string
      tags:
      - applications
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedApplicationListList'
          description: ''
  /api/applications/stats/:
    get:
      operationId: get_application_stats
      description: Get application statistics for organization
      tags:
      - applications
      security:
      - jwtAuth: []
      responses:
        '200':
          description: Application statistics
        '403':
          description: Only organizations allowed
  /api/applications/upload-document/:
    post:
      operationId: applications_upload_document
      description: Upload a document file for applications (temporary storage until
        linked to specific application)
      summary: Upload Application Document
      tags:
      - applications
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ApplicationDocumentUpload'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ApplicationDocumentUpload'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ApplicationDocumentUpload'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApplicationDocumentUploadResponse'
          description: ''
        '400':
          description: Bad request - invalid file type or size
        '401':
          description: Authentication required
        '500':
          description: File upload failed
  /api/auth/change-password/:
    put:
      operationId: auth_change_password_update
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ChangePassword'
          application/x-www-form-urlencoded:
