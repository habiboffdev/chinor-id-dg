components:
  schemas:
    AcademicExam:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        slug:
          type: string
          maxLength: 40
          pattern: ^[-a-zA-Z0-9_]+$
        name:
          type: string
          maxLength: 100
        description:
          type: string
        sections:
          type: array
          items:
            $ref: '#/components/schemas/AcademicExamSection'
          readOnly: true
      required:
      - id
      - name
      - sections
      - slug
    AcademicExamSection:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 100
        min_score:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
        max_score:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
        step:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
        sort_order:
          type: integer
          maximum: 2147483647
          minimum: 0
      required:
      - id
      - max_score
      - name
    Achievement:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          maxLength: 200
        achievement_type:
          $ref: '#/components/schemas/AchievementTypeEnum'
        description:
          type: string
        issuing_organization:
          type: string
          maxLength: 200
        date_achieved:
          type: string
          format: date
        certificate:
          type: string
          format: uri
        certificate_url:
          type: string
          format: uri
          maxLength: 200
        student:
          type: integer
          readOnly: true
      required:
      - achievement_type
      - date_achieved
      - description
      - id
      - issuing_organization
      - student
      - title
    AchievementTypeEnum:
      enum:
      - award
      - certification
      - competition
      - scholarship
      - recognition
      - publication
      type: string
      description: |-
        * `award` - Award
        * `certification` - Certification
        * `competition` - Competition
        * `scholarship` - Scholarship
        * `recognition` - Recognition
        * `publication` - Publication
    Application:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        student:
          allOf:
          - $ref: '#/components/schemas/StudentProfile'
          readOnly: true
        opportunity:
          allOf:
          - $ref: '#/components/schemas/OpportunityList'
          readOnly: true
        status:
          $ref: '#/components/schemas/NewStatusEnum'
        additional_documents: {}
        applied_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        reviewed_at:
          type: string
          format: date-time
          nullable: true
        reviewer_notes:
          type: string
        interview_date:
          type: string
          format: date-time
          nullable: true
        interview_notes:
          type: string
        documents:
          type: array
          items:
            $ref: '#/components/schemas/ApplicationDocument'
          readOnly: true
        notes:
          type: array
          items:
            $ref: '#/components/schemas/ApplicationNote'
          readOnly: true
        status_history:
          type: array
          items:
            $ref: '#/components/schemas/ApplicationStatusHistory'
          readOnly: true
        answers:
          type: array
          items:
            $ref: '#/components/schemas/ApplicationAnswer'
          readOnly: true
        student_name:
          type: string
          readOnly: true
        opportunity_title:
          type: string
          readOnly: true
        organization_name:
          type: string
          readOnly: true
        days_since_applied:
          type: integer
          readOnly: true
      required:
      - answers
      - applied_at
      - days_since_applied
      - documents
      - id
      - notes
      - opportunity
      - opportunity_title
      - organization_name
      - status_history
      - student
      - student_name
      - updated_at
    ApplicationAnswer:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        question:
          type: integer
        question_text:
          type: string
          readOnly: true
        question_type:
          type: string
          readOnly: true
        answer_text:
          type: string
        answer_file:
          type: string
          format: uri
          nullable: true
      required:
      - id
      - question
      - question_text
      - question_type
    ApplicationCreate:
      type: object
      properties:
        opportunity:
          type: integer
      required:
      - opportunity
    ApplicationDocument:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        document:
          type: string
          format: uri
        document_type:
          type: string
          maxLength: 50
        uploaded_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - document
      - document_type
      - id
      - uploaded_at
    ApplicationDocumentUpload:
      type: object
      description: Serializer for application document uploads
      properties:
        file:
          type: string
          format: uri
          description: 'Document file (PDF, DOC, DOCX, TXT, JPG, PNG). Max size: 10MB.'
      required:
      - file
    ApplicationDocumentUploadResponse:
      type: object
      description: Response serializer for successful document upload
      properties:
        file_url:
          type: string
          format: uri
          description: URL of the uploaded document
        filename:
          type: string
          description: Original filename
        size:
          type: integer
          description: File size in bytes
        content_type:
          type: string
          description: MIME type of the uploaded file
      required:
      - content_type
      - file_url
      - filename
      - size
    ApplicationList:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        student:
          type: integer
        opportunity:
          type: integer
        status:
          $ref: '#/components/schemas/NewStatusEnum'
        applied_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        student_name:
          type: string
          readOnly: true
        student_email:
          type: string
          readOnly: true
        student_university:
          type: string
          readOnly: true
        opportunity_title:
          type: string
          readOnly: true
        organization_name:
          type: string
          readOnly: true
        days_since_applied:
          type: string
          readOnly: true
      required:
      - applied_at
      - days_since_applied
      - id
      - opportunity
      - opportunity_title
      - organization_name
      - student
      - student_email
      - student_name
      - student_university
      - updated_at
    ApplicationNote:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        author:
          type: integer
          readOnly: true
        author_name:
          type: string
