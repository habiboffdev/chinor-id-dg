# Telegram Bot configuration
BOT_TOKEN=CHANGE_ME
BOT_USERNAME=YOUR_BOT_USERNAME
# Django settings module if you want ORM access from bot
DJANGO_SETTINGS_MODULE=opportuni.settings.development
# Optional base URL to open as Telegram Web App button
TELEGRAM_WEBAPP_URL=https://example.com
# Optional channel URL for users to open (e.g., https://t.me/opportuni_channel)
TELEGRAM_CHANNEL_URL=https://t.me/opportuni_channel
# Channel ID for posting opportunities (e.g., @opportuni_channel or -1001234567890)
TELEGRAM_CHANNEL_ID=@opportuni_channel
# Enable/disable Telegram bot integration with Django
TELEGRAM_BOT_ENABLED=true
# Comma-separated admin user IDs who can use admin commands
TELEGRAM_ADMIN_IDS=123456789,987654321
# Comma-separated language codes you want to enable
I18N_LANGS=en,ru,uz
DEFAULT_LANG=en
